{
  "name": "ruins",
  "version": "0.2.3",
  "keywords": [
    "ruins",
    "lint",
    "eslint",
    "migration",
    "todos"
  ],
  "author": "Ian Bobinac",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/maybebot/ruins"
  },
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "bin": {
    "ruins": "./cli.js"
  },
  "module": "./dist/all.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/config/index.d.ts",
        "default": "./dist/config/index.js"
      }
    },
    "./rule-todo": {
      "import": "./dist/plugins/structured-todos.js"
    }
  },
  "scripts": {
    "api:prepare": "cd api && nitro prepare",
    "api:build": "cd api && nitro build",
    "api:dev": "cd api && nitro dev",
    "api:preview": "node ./api/.output/server/index.mjs",
    "serve": "http-server -p 8080 ./ui/dist",
    "ui:dev": "cd ui && vite",
    "ui:build": "cd ui && vite build",
    "ui:preview": "cd ui && vite preview",
    "dev": "concurrently \"pnpm api:dev\" \"pnpm ui:dev\"",
    "build": "tsc && cd ui && vite build && cd ../api && nitro build",
    "try": "bash ./scripts/try.sh",
    "release": "release-it"
  },
  "dependencies": {
    "c12": "^3.3.4",
    "concurrently": "^9.2.1",
    "consola": "^3.4.2",
    "eslint-plugin-structured-todo": "^0.2.2",
    "http-server": "^14.1.1",
    "monogon": "^0.3.4",
    "nevera": "^0.0.8",
    "pyro": "^0.1.27",
    "vite-svg-loader": "^5.1.1",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^10.4.0",
    "nitropack": "latest",
    "release-it": "^20.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.14",
    "vite-plugin-vue-devtools": "^8.1.2"
  },
  "peerDependencies": {
    "eslint": "*"
  }
}
