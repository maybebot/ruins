{
  "name": "ruins",
  "version": "0.3.0-beta.0",
  "type": "module",
  "license": "MIT",
  "author": "Ian Bobinac",
  "description": "",
  "keywords": [
    "ruins",
    "lint",
    "eslint",
    "migration",
    "todos"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/maybebot/ruins"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bash ./scripts/build.sh",
    "dev": "tsx --watch ./index.ts",
    "dev:ui": "pnpm exec tsdown && node ./apps/ui/node_modules/vite/bin/vite.js apps/ui --config apps/ui/vite.config.ts",
    "start": "tsx ./index.ts",
    "lint": "oxlint --type-aware",
    "try": "bash ./scripts/try.sh"
  },
  "main": "./dist/index.mjs",
  "exports": {
    ".": "./dist/index.mjs",
    "./rule-todo": "./dist/plugins/structured-todos.mjs"
  },
  "bin": {
    "ruins": "./dist/cli.mjs"
  },
  "devDependencies": {
    "@ruins/cli": "workspace:*",
    "@ruins/codeowners": "workspace:*",
    "@ruins/commits": "workspace:*",
    "@ruins/config": "workspace:*",
    "@ruins/lint": "workspace:*",
    "@ruins/todo": "workspace:*",
    "@ruins/views": "workspace:*",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "prettier": "3.10.1",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2"
  },
  "dependencies": {
    "@bomb.sh/args": "^0.3.1",
    "@bomb.sh/tty": "^0.10.0",
    "@clack/prompts": "^1.9.0",
    "confbox": "^0.3.2",
    "eslint-plugin-structured-todo": "^0.2.2",
    "consola": "catalog:"
  }
}
