    "@ruins/lint": "workspace:*",
    "@ruins/todo": "workspace:*",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^0.6.0",
    "prettier": "3.6.2",
    "tsdown": "^0.15.12",
    "tsx": "^4.20.4",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "citty": "catalog:",
    "consola": "catalog:"
  }
